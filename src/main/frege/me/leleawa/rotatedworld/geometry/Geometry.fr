--- 服务端坐标 <-> 客户端坐标：整个插件只有这一份旋转定义。
---
--- 绕 X 轴旋转 90°（行列式为 +1，不是镜像）：
---
---   client = (x, z + off, -y)
---   server = (x, -z, y - off)
---
--- 服务端 Z 轴变成客户端竖直方向，off 是浮动原点偏移（16 的倍数），
--- 用来把服务端无限长的 Z 轴折进客户端有限的高度窗口。x 分量在旋转里不变，所以这里只有 y / z 的函数。
---
--- Frege 把每个顶层函数编译成 public static Java 方法，参数和返回值都是 int / double / float，
--- 上层（Scala、Groovy、Kotlin）直接调用，没有装箱。
--- 下面的 prop_* 是 QuickCheck 性质，`./gradlew checkGeometry` 会跑它们。
module me.leleawa.rotatedworld.geometry.Geometry where

import Test.QuickCheck
import frege.prelude.Math (sin, cos, asin, atan2, pi, floor)

-- ---------------------------------------------------------------- 方块（格子）

--- 方块是格子不是点：变号的那个轴要多减 1（格子 [y, y+1) 变号后是 [-y-1, -y)）。
blockToClientY :: Int -> Int -> Int
blockToClientY z off = z + off

blockToClientZ :: Int -> Int
blockToClientZ y = negate y - 1

blockToServerY :: Int -> Int
blockToServerY z = negate z - 1

blockToServerZ :: Int -> Int -> Int
blockToServerZ y off = y - off

-- ---------------------------------------------------------------- 点 / 向量

pointToClientY :: Double -> Int -> Double
pointToClientY z off = z + off.double

pointToClientZ :: Double -> Double
pointToClientZ y = negate y

--- 方向向量（速度、击退、方块面的法向量……）：不带 offset。
vecToClientY :: Double -> Double
vecToClientY z = z

vecToClientZ :: Double -> Double
vecToClientZ y = negate y

vecToServerY :: Double -> Double
vecToServerY z = negate z

vecToServerZ :: Double -> Double
vecToServerZ y = y

--- 声音坐标是 (坐标 * 8) 的整数。
soundToClientY :: Int -> Int -> Int
soundToClientY z off = z + off * 8

--- UseItemOn 的方块内光标位置 (0..1)：client (cx, cy, cz) -> server (cx, 1 - cz, cy)。
cursorToServerY :: Float -> Float
cursorToServerY cz = 1.0f - cz

cursorToServerZ :: Float -> Float
cursorToServerZ cy = cy

-- ---------------------------------------------------------------- 被旋转的玩家自己

--- 服务端玩家碰撞箱被缩放到 1/3：0.2 x 0.6 x 0.2。
scale :: Double
scale = 1.0 / 3.0

--- 服务端小碰撞箱放在客户端身体（换算到服务端后是一个躺着的 0.6x0.6x1.8 长方体）里面：
---   服务端 y 方向：[-cz-0.3, -cz+0.3]，刚好 0.6 高
---   服务端 z 方向：[cy+1.25, cy+1.45]（相对脚底），潜行时身体只有 1.5 高，也能装下
--- 客户端能看到旋转后的方块，保证身体在空处，所以服务端碰撞箱也一定在空处，不会被拉回。
selfY :: Double
selfY = 0.3

selfZ :: Double
selfZ = 1.35

selfToClientY :: Double -> Int -> Double
selfToClientY z off = z + off.double - selfZ

selfToClientZ :: Double -> Double
selfToClientZ y = negate y - selfY

selfToServerY :: Double -> Double
selfToServerY z = negate z - selfY

selfToServerZ :: Double -> Int -> Double
selfToServerZ y off = y - off.double + selfZ

-- ---------------------------------------------------------------- 视角

--- yaw / pitch -> 单位方向向量（Minecraft 的约定：yaw 0 朝 +z，pitch 正值朝下）。
direction :: Float -> Float -> (Double, Double, Double)
direction yaw pitch = (negate (sin y) * c, negate (sin p), cos y * c)
  where
    y = yaw.double * pi / 180.0
    p = pitch.double * pi / 180.0
    c = cos p

--- 方向向量 -> (yaw, pitch)。
angles :: (Double, Double, Double) -> (Float, Float)
angles (x, y, z) = (yaw.float, pitch.float)
  where
    pitch = negate (asin (max (-1.0) (min 1.0 y))) * 180.0 / pi
    yaw   = if abs x < 1e-7 && abs z < 1e-7 then 0.0 else atan2 (negate x) z * 180.0 / pi

lookToServer :: Float -> Float -> (Float, Float)
lookToServer yaw pitch = angles (x, negate z, y) where (x, y, z) = direction yaw pitch

lookToClient :: Float -> Float -> (Float, Float)
lookToClient yaw pitch = angles (x, z, negate y) where (x, y, z) = direction yaw pitch

--- 给 Java 的入口：元组在 Java 里不好用，拆成返回 float 的函数；! 让参数是严格的（Java 里就是 float，不是 Lazy）。
lookToServerYaw, lookToServerPitch, lookToClientYaw, lookToClientPitch :: Float -> Float -> Float
lookToServerYaw   !yaw !pitch = fst (lookToServer yaw pitch)
lookToServerPitch !yaw !pitch = snd (lookToServer yaw pitch)
lookToClientYaw   !yaw !pitch = fst (lookToClient yaw pitch)
lookToClientPitch !yaw !pitch = snd (lookToClient yaw pitch)

-- ---------------------------------------------------------------- 区块 / section

--- 浮动原点只能按整 section 移动：取最近的 16 的倍数（Double.round 就是 Java 的 Math.round）。
align16 :: Double -> Int
align16 v = (Double.round (v / 16.0)).int * 16

--- 客户端区块柱需要的服务端区块 z 范围从这里开始：[zBase, zBase + section 数)。
zBase :: Int -> Int -> Int
zBase minY off = (minY - off) `div` 16

--- 客户端区块柱 cz 的方块全部来自服务端的第 serverSection 个 section（客户端 z 对应服务端 -y），
--- 反过来也一样（这个映射是自己的逆）。
serverSectionOfColumn :: Int -> Int
serverSectionOfColumn cz = negate cz - 1

--- 服务端 section (sx, sy, sz) 整个落在客户端 section (sx, sectionToClientY sz off, serverSectionOfColumn sy) 里。
sectionToClientY :: Int -> Int -> Int
sectionToClientY sz off = (sz * 16 + off) `div` 16

--- section 内坐标：服务端 (x, y, z) -> 客户端 (lx = x, ly = z, lz = 15 - y)，
--- 打包成客户端 section 内下标 (ly shl 8 or lz shl 4 or lx)。
localIndex :: Int -> Int -> Int -> Int
localIndex x y z = z * 256 + (15 - y) * 16 + x

--- 边长为 n 的立方体（方块 n = 16，群系格 n = 4）里，客户端 lz 对应的服务端 y。
localServerY :: Int -> Int -> Int
localServerY n lz = n - 1 - lz

-- ================================================================ 性质

--- 小整数坐标（世界范围内）和 16 的倍数的 offset
offsets = fmap (* 16) (choose (-200, 200))
coords  = choose (-30000000, 30000000)

prop_blockRoundTrip = forAll coords $ \y -> forAll coords $ \z -> forAll offsets $ \off ->
    blockToServerY (blockToClientZ y) == y && blockToServerZ (blockToClientY z off) off == z

--- 格子映射和点映射一致：格子 [y, y+1) 映射后正好是 [cz, cz+1)。
prop_blockMatchesPoint = forAll coords $ \y ->
    blockToClientZ y == (Double.round (floor (pointToClientZ (y.double + 1.0)))).int

prop_selfRoundTrip = forAll (choose (-3.0e7, 3.0e7)) $ \(y :: Double) -> forAll (choose (-3.0e7, 3.0e7)) $ \(z :: Double) -> forAll offsets $ \off ->
    approx (selfToServerY (selfToClientZ y)) y && approx (selfToServerZ (selfToClientY z off) off) z

--- 旋转是正交的：方向向量转过去再转回来不变（离两极太近时 yaw 没有意义，跳过）。
prop_lookRoundTrip = forAll (choose (-180.0, 180.0)) $ \(yaw :: Double) -> forAll (choose (-89.0, 89.0)) $ \(pitch :: Double) ->
    let (sy, sp) = lookToServer yaw.float pitch.float
        (cy, cp) = lookToClient sy sp
        (x1, y1, z1) = direction yaw.float pitch.float
        (x2, y2, z2) = direction cy cp
    in abs x1 + abs z1 < 1e-3 || (approxDir x1 x2 && approxDir y1 y2 && approxDir z1 z2)

--- 方向向量的旋转和视角的旋转是同一个旋转。
prop_lookMatchesVec = forAll (choose (-180.0, 180.0)) $ \(yaw :: Double) -> forAll (choose (-60.0, 60.0)) $ \(pitch :: Double) ->
    let (x, y, z) = direction yaw.float pitch.float
        (cyaw, cpitch) = lookToClient yaw.float pitch.float
        (x2, y2, z2) = direction cyaw cpitch
    in approxDir x x2 && approxDir (vecToClientY z) y2 && approxDir (vecToClientZ y) z2

prop_align16 = forAll (choose (-1.0e6, 1.0e6)) $ \(v :: Double) ->
    let a = align16 v in a `mod` 16 == 0 && abs (a.double - v) <= 8.0

--- zBase 是向下取整的除法（不是 Java 的向零取整）。
prop_zBaseFloors = forAll (choose (-2032, 2032)) $ \minY -> forAll offsets $ \off ->
    let b = zBase minY off in b * 16 <= minY - off && minY - off < b * 16 + 16

prop_columnSectionInvolution = forAll coords $ \cz -> serverSectionOfColumn (serverSectionOfColumn cz) == cz

--- 一个服务端 section 里的每个方块，映射后都落在 sectionToClientY 算出的那个客户端 section 里。
prop_sectionContainsBlocks = forAll (choose (-100, 100)) $ \sz -> forAll offsets $ \off -> forAll (choose (0, 15)) $ \lz ->
    (blockToClientY (sz * 16 + lz) off) `div` 16 == sectionToClientY sz off

--- 4096 个格子解码回来都是自己，且下标都在 [0, 4096) 里：是一一映射。
prop_localIndexBijective = once $ and [ decode (localIndex x y z) == (x, y, z) | x <- [0..15], y <- [0..15], z <- [0..15] ]
  where decode i = (i `mod` 16, localServerY 16 ((i `div` 16) `mod` 16), i `div` 256)

approx :: Double -> Double -> Bool
approx a b = abs (a - b) <= 1e-6 * (1.0 + abs a + abs b)

approxDir :: Double -> Double -> Bool
approxDir a b = abs (a - b) <= 1e-4
